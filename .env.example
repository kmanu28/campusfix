# Copy this file to .env and adjust. Never commit .env.

# --- PostgreSQL with pgvector -------------------------------------------------------------
# Local (docker compose up -d):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/campusfix
# Hosted example (Supabase / Neon):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SSL is automatic: off for localhost, on for remote hosts. Override with PGSSL=disable | require
# PGSSL=

# --- MongoDB (document store for upvotes / keywords / metadata) -----------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/campusfix_nosql

# --- Sessions -------------------------------------------------------------------------------
# Secret used to sign the login cookie (>= 16 chars). REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Demo helpers ---------------------------------------------------------------------------
# true  = login page lists seeded accounts for one-click sign-in (never enable in production)
DEMO_MODE=true
# Password given to the seeded demo accounts by `npm run db:setup`
DEMO_PASSWORD=password123
